<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0-preview.56</Version>
    <FileVersion>0.1.0.56</FileVersion>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Product>NetworkDiagramStudio</Product>
    <Company>TechSavage1989</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NativeSmokeBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);NDS_TEST_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SwitchportReports/**/*.cs" />
    <ProjectReference Include="SwitchportReports/NetworkDiagramStudio.SwitchportReports.csproj" />
    <Compile Include="../tests/desktop/NativeSmoke.cs" Condition="'$(NativeSmokeBuild)' == 'true'" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="../docs/THIRD_PARTY_NOTICES.md" LogicalName="notices/Components.md" />
    <EmbeddedResource Include="SwitchportReports/Fonts/LICENSE.txt" LogicalName="notices/Report fonts license.txt" />
    <EmbeddedResource Include="SwitchportReports/Notices/*" LogicalName="notices/Switchport/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(NuGetPackageRoot)/microsoft.web.webview2/1.0.4314.35/LICENSE.txt" LogicalName="notices/WebView2 SDK license.txt" />
    <EmbeddedResource Include="$(NuGetPackageRoot)/microsoft.web.webview2/1.0.4314.35/NOTICE.txt" LogicalName="notices/WebView2 SDK notice.txt" />
    <EmbeddedResource Include="$(NuGetPackageRoot)/microsoft.netcore.app.runtime.win-x64/**/LICENSE.TXT;$(NuGetPackageRoot)/microsoft.netcore.app.runtime.win-x64/**/THIRD-PARTY-NOTICES.TXT" LogicalName="notices/Dotnet/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(NuGetPackageRoot)/microsoft.windowsdesktop.app.runtime.win-x64/**/LICENSE" LogicalName="notices/WindowsDesktop/%(RecursiveDir)LICENSE" />
    <EmbeddedResource Include="../src/web/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
